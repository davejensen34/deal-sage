# Core
DEMO_MODE=true
DEMO_ANALYST_NAME=Morgan Lee
AUTH_MODE=demo
SESSION_SECRET=development-only-change-me
SESSION_COOKIE_SECURE=false
WEB_APP_URL=http://localhost:3000
DATABASE_URL=sqlite:///./dealsage.db
EVIDENCE_STORAGE_PATH=./data/evidence
CORS_ORIGINS=http://localhost:5173

# Pilot identity (required only when AUTH_MODE=oidc)
OIDC_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional bounded AI assistance (disabled, openai, or anthropic).
# Keep disabled until the selected key is present. Live calls are never part of tests.
MODEL_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_CALLS_PER_CASE=2
AI_MAX_COST_CENTS_PER_CASE=25
# DealSage currently requires false so OpenAI Responses are not retained provider-side.
AI_STORE_PROVIDER_RESPONSES=false
